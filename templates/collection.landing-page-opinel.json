            "heading": "Step 1:",
            "heading_size": "h3",
            "heading_h1": false
          }
        },
        "text_6kPLTg": {
          "type": "text",
          "settings": {
            "text": "<p><strong>Pour-Over</strong></p><ul><li>As hot water is poured over the grounds, the coffee is wetted and aerated.</li><li>This aeration, which can be further accelerated by stirring, speeds up the extraction process and helps remove sour carbon dioxide from the brew.</li><li>This method unlocks a smooth flavor profile, characteristic of a pour-over.</li></ul>",
            "enlarge_text": true
          }
        },
        "button_kDG6Ut": {
