    "testimonials_f9N9xH": {
      "type": "testimonials",
      "blocks": {
        "testimonial_Lphfpa": {
          "type": "testimonial",
          "settings": {
            "testimonial": "<p>I bought the FT3 and it is the perfect size to prepare a main course for two people or to prepare a side dish for more people.<br/>The quality is excellent, far better than i expected - I'm really looking forward to growing old with this Dutch Oven!!</p><p>I also bought the transport bag - the quality is as good as the pot! In fact, you would be doing an injustice to this amazing Dutch Oven without buying the bag.</p>",
            "author": "- Craig S",
            "author_info": "",
            "show_star_rating": true,
