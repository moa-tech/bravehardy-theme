        "only_content_color_scheme": false
      }
    },
    "media_with_text_RQMdpC": {
      "type": "media-with-text",
      "blocks": {
        "heading_dej4Dw": {
          "type": "heading",
          "settings": {
            "heading": "Comes with a built in dragon",
            "heading_size": "h3",
            "heading_h1": false
          }
        },
        "text_XMkEG6": {
          "type": "text",
          "settings": {
            "text": "<p>Didn't you dream of having your very own dragon growing up? Anything adorned with a prominent dragon emblem signifies its resilience to fire and its robust nature. Dragon's are cool.</p>",
            "enlarge_text": true
          }
        }
      },
      "block_order": [
