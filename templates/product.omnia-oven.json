    "media_with_text_7ftHhm": {
      "type": "media-with-text",
      "blocks": {
        "heading_dQEfXw": {
          "type": "heading",
          "settings": {
            "heading": "Use the lid as a frypan",
            "heading_size": "h3",
            "heading_h1": false
          }
        },
        "text_GfxD3A": {
          "type": "text",
          "settings": {
            "text": "<p>That's one of the great features of the Petromax Dutch oven. Its versatility allows you to use it not just as a pot for slow cooking or baking but also as a skillet for frying or sautéing when you flip the lid over. </p><p>The lid's legs make it stable on the fire or stove.</p>",
            "enlarge_text": true
          }
        }
      },
      "block_order": [
        "heading_dQEfXw",
        "text_GfxD3A"
      ],
      "disabled": true,
      "settings": {
        "image": "shopify://shop_images/DSC01602DSC01602.webp",
