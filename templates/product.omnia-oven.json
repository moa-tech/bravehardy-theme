    "product_features_qpYmda": {
      "type": "product-features",
      "blocks": {
        "feature_YEzDfH": {
          "type": "feature",
          "settings": {
            "heading": "The Lid",
            "text": "<p>A distinctively tall, red aluminium lid with small ventilation holes.</p>",
            "content_align": "text-start",
            "hotspot_x": 35,
            "hotspot_y": 20
          }
        },
        "feature_B7aha7": {
          "type": "feature",
          "settings": {
            "heading": "The Aluminium Baking Pan",
            "text": "<p>This is a circular bundt-style pan (with a hole in the middle) where you place your food. It sits on top of the steel base.</p>",
            "content_align": "text-start",
            "hotspot_x": 70,
            "hotspot_y": 43
          }
        },
        "feature_JdLHg7": {
          "type": "feature",
          "settings": {
            "heading": "The Stainless Steel Base",
            "text": "<p>This is a bowl-shaped steel ring that sits directly on the burner. It acts as a heat shield and diffuser. Instead of the flame touching the baking pan directly, it heats the air trapped between the base and the pan.</p>",
            "content_align": "text-start",
            "hotspot_x": 50,
            "hotspot_y": 82
          }
        }
      },
      "block_order": [
        "feature_YEzDfH",
        "feature_B7aha7",
        "feature_JdLHg7"
      ],
      "name": "Product features",
      "settings": {
        "product": "omnia-classic-original-oven-2-litre",
        "show_content": true,
        "layout": "text_first",
        "text_align": "text-center",
        "mob_center_text": false,
        "heading_size": "h1",
        "enlarge_text": false,
        "image": "shopify://shop_images/omnia-oven-transparent_8eb0788d-5331-43b6-bac5-435a49a348e2.jpg",
        "title": "Omnia Oven",
        "description": "<p>The Omnia Oven allows you to bake and roast on a stovetop by mimicking the thermodynamics of a traditional oven. It transforms direct heat from a burner into surrounding heat (convection), allowing food to cook from both the top and bottom rather than just frying from below.</p>",
        "button_label": "",
        "button_link": "",
        "hotspot_color": "#070707",
        "color_scheme": "none",
        "button_style": "btn btn--primary"
      }
    },
    "faq_JQmLfP": {
      "type": "faq",
      "blocks": {
        "question_nLaxtg": {
          "type": "question",
          "settings": {
            "icon": "none",
            "heading": "Does the Omnia Oven work on induction stoves?",
            "text": "<p>No, the Omnia Classic 2L Oven does not work on induction. It is designed for use on gas stoves and can work on electric hobs too.</p>"
          }
        },
        "question_zWLF6y": {
          "type": "question",
          "settings": {
            "icon": "none",
            "heading": "Can I use the Omnia Oven on a braai?",
            "text": "<p>Yes, you can definitely use the Omnia on a braai! It's great for cooking over an open fire or coals. Just make sure it's placed stably and that the heat isn't too intense directly underneath to prevent burning. Heat management is going to be your challenge. Will you accept the challenge?</p>"
          }
        },
        "question_t6UFcJ": {
          "type": "question",
          "settings": {
            "icon": "none",
            "heading": "Should there be water in the base?",
            "text": "<p>No, there should not be water in the base of the Omnia. The design relies on direct heat from below and circulating hot air, similar to a traditional oven. Adding water would interfere with this cooking method.</p>"
          }
        },
        "question_hE3LCQ": {
          "type": "question",
          "settings": {
            "icon": "none",
            "heading": "How do I know how much heat to use?",
            "text": "<p>Getting the right heat for your Omnia can take a little practice, as it varies depending on your heat source and what you're cooking. The most important thing is to <strong>be careful with the heat, especially on a gas stove where it's easy to get too hot.</strong></p><p><strong>Helpful Hint!<br/></strong>For recipes with short cooking times (10–20 minutes in total) and when using an electric hot plate, you can preheat the stainless steel base on high heat for about 3 minutes. This helps the oven heat up more efficiently. For some breads and cakes, you might want to \"kick-start\" them by preheating both the base and oven at the highest heat for 1 minute, similar to how you'd preheat a regular oven for better baking results.</p>"
          }
        },
        "question_YaD9f9": {
          "type": "question",
          "settings": {
            "icon": "none",
            "heading": "Can I put the Omnia Classic in the dishwasher?",
            "text": "<p>Please avoid using the dishwasher! Aluminium should be washed by hand to avoid discolouration.</p>"
          }
        }
      },
      "block_order": [
        "question_nLaxtg",
        "question_zWLF6y",
        "question_t6UFcJ",
        "question_hE3LCQ",
        "question_YaD9f9"
      ],
      "name": "Collapsible content",
      "settings": {
        "heading": "Omnia Oven FAQ's",
        "heading_align": "text-center",
        "color_scheme": "1",
        "full_width": true
      }
